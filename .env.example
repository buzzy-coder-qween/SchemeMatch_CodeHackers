# Copy this file to `.env` and fill in the values.
#   cp .env.example .env

# Google Gemini API key used for natural-language profile parsing and the
# scheme copilot. Optional: without a key the app falls back to the
# deterministic rule-based extractor and offline copilot responses.
# Get a key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# Public URL where the app is served. Used for self-referential links.
APP_URL="http://localhost:3000"
